<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="iofabrik"
        Arguments=""
        InstallLocation="C:\Program Files\IOFabrik\IOFabrik">
    </Installer>
    <PackageInformation
        PackageName="IOFabrik"
        PackageDisplayName="IOFabrik"
        PublisherName="CN=IOFabrik"
        PublisherDisplayName="IOFabrik"
        Version="0.1.0.0"
        PackageDescription="IOFabrik">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.iofabrik.iofabrik"
                Description="IOFabrik"
                DisplayName="IOFabrik"
                ExecutableName="iofabrik"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>IOFabrik</DisplayName>
            <PublisherDisplayName>IOFabrik</PublisherDisplayName>
            <Description>IOFabrik</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="iofabrik.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
