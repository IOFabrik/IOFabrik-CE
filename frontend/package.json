{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "lint": "npm run lint:hygiene",
    "lint:hygiene": "node ./src/scripts/enforce-frontend-hygiene.mjs",
    "typecheck": "tsc --noEmit",
    "ci:guards": "npm run lint && npm run check:ladder-visualizer && npm run typecheck",
    "check:ladder-visualizer": "node ./src/scripts/check-ladder-visualizer-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@wailsio/runtime": "3.0.0-beta.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ladder-visualizer": "git+https://github.com/IOFabrik/ladder-visualizer.git#8afb87074df26c6617966b080df70220d18f66ed",
    "lucide-react": "^0.562.0",
    "online-3d-viewer": "^0.18.0",
    "pixelmatch": "^7.1.0",
    "posthog-js": "^1.425.1",
    "react": "^18.2.0",
    "react-diff-view": "^3.3.2",
    "react-dom": "^18.2.0",
    "react-pdf": "^10.3.0",
    "react-photo-view": "^1.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.9",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
